{
  "name": "algo-trading-platform",
  "version": "1.0.0",
  "description": "Full-stack algorithmic trading platform with backtesting",
  "scripts": {
    "install:all": "npm install --prefix backend && npm install --prefix frontend",
    "dev:backend": "npm run dev --prefix backend",
    "dev:frontend": "npm run dev --prefix frontend",
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "build": "npm run build --prefix frontend",
    "seed": "npm run seed --prefix backend",
    "vercel-build": "npm run build --prefix frontend"
  },
  "keywords": [
    "trading",
    "backtesting",
    "algorithmic",
    "finance"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "date-fns": "^2.30.0",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "express-validator": "^7.0.1",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "mathjs": "^12.0.0",
    "mongoose": "^8.0.0",
    "vm2": "^3.9.19"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "nodemon": "^3.1.11"
  }
}
